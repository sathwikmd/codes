import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
      int count=0;
        for(int i=1;i<=100;i++)
            {
                if(i%2!=0)
                {
                  count++;
                }
            }
        System.out.println("The total numbers between 1-100 odd numberss:\n" + count);
    }
}
